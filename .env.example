# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is already in .gitignore.

# --- Postgres (Prisma) -------------------------------------------------
# Point both at the same IPv4-reachable connection. DIRECT_URL is only used
# for migrations and interactive transactions, so sharing one value is safe.
DATABASE_URL=
DIRECT_URL=

# --- Supabase (browser SDK — public values, safe to expose) ------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server side) --------------------------------------------
# Optional. The anon key alone can verify a token. Add the service role key
# if you later need admin operations such as listing or creating users.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session ------------------------------------------------------------
# 32+ random characters. Signs the httpOnly session JWT.
SESSION_SECRET=

# --- AI provider --------------------------------------------------------
MEOW_AI_API_KEY=
MEOW_AI_API_URL=

# --- Access control -----------------------------------------------------
# Comma-separated. Required to reach /admin.
MEOW_AI_ADMIN_EMAILS=
# Optional comma-separated allowlist. Unset = invite-only via admin grants.
MEOW_AI_ALLOWED_EMAILS=
