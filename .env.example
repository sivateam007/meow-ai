# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is already in .gitignore.

# --- Postgres (Prisma) -------------------------------------------------
# Point both at the same IPv4-reachable connection. DIRECT_URL is only used
# for migrations and interactive transactions, so sharing one value is safe.
DATABASE_URL=
DIRECT_URL=

# --- Session ------------------------------------------------------------
# 32+ random characters. Signs the httpOnly session JWT.
SESSION_SECRET=

# --- Sign-in ------------------------------------------------------------
# The single shared password for this single-user app. Run `npm run secret`
# to generate a passphrase, or to have one stored as an scrypt hash.
# Use a long random string — this is the only thing protecting the app.
MEOW_LOGIN_SECRET=

# Optional. The identity carried by the session cookie; chat history is keyed
# off this email address. Defaults to the first entry of MEOW_AI_ADMIN_EMAILS.
MEOW_LOGIN_EMAIL=
# Optional display name shown next to messages. Defaults to "Meow".
MEOW_LOGIN_NAME=

# --- AI provider --------------------------------------------------------
MEOW_AI_API_KEY=
MEOW_AI_API_URL=

# --- Access control -----------------------------------------------------
# Comma-separated. Required to reach /admin. Also the default login identity.
MEOW_AI_ADMIN_EMAILS=
